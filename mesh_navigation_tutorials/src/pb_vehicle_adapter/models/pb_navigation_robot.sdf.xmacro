<?xml version="1.0"?>
<sdf version="1.7">
  <!--
    Local navigation wrapper for the PB2025 simulation model, low-clearance
    variant (see doc/PB_LOW_CLEARANCE_VEHICLE_PLAN.md).

    The upstream `rm25_example_robot` macro is intentionally NOT instantiated:
    it expands the gimbal, armor, light bar, speed monitor and the in-chassis
    projectile container, which put the collision envelope at z = 0.4491 m and
    made the vehicle unable to enter the RMUC tunnel (local clear height about
    0.247 m).  Instead this file defines a local `pb_low_chassis` macro that
    keeps only base_footprint / base_to_chassis / chassis / four wheels, with a
    box body and the three sensors mounted low and fixed.

    Nothing under third_party/ is modified: the wheel macro still comes from the
    upstream `chassis_wheel.def.xmacro`, and the sensor macros are local copies
    with simplified geometry so the generated link/sensor names (and therefore
    the topic assignment in tools/generate_descriptions.py) stay unchanged.
  -->
  <xmacro_include uri="model://rmua19_standard_robot/chassis_wheel.def.xmacro" />

  <xmacro_define_value name="global_initial_color" value="none" />

  <!-- Low chassis: no gimbal, no armor, no projectile container, box body. -->
  <xmacro_define_block name="pb_low_chassis" params="chassis_height">
    <link name="base_footprint"/>
    <joint name="base_to_chassis" type="fixed">
      <pose>0 0 ${chassis_height} 0 0 0</pose>
      <parent>base_footprint</parent>
      <child>chassis</child>
    </joint>

    <link name="chassis">
      <inertial>
        <!-- Mass/inertia kept from the upstream chassis block as a starting
             value; the removed superstructure is not compensated here. -->
        <pose>0 0 0.055 0 0 0</pose>
        <xmacro_block name="inertia_box" m="15.0" x="0.36" y="0.24" z="0.13"/>
      </inertial>
      <!-- Visual matches the collision box on purpose: the upstream
           chassis_base.dae still contains the projectile container, which would
           make the low vehicle look tall. -->
      <visual name="chassis_visual">
        <pose>0 0 0.045 0 0 0</pose>
        <xmacro_block name="geometry_box" x="0.36" y="0.24" z="0.13"/>
      </visual>
      <collision name="chassis_base_collision">
        <pose>0 0 0.045 0 0 0</pose>
        <xmacro_block name="geometry_box" x="0.36" y="0.24" z="0.13"/>
      </collision>
      <collision name="chassis_fornt_wheel_holder_collision">
        <pose>0.208 0 0 0 0 0</pose>
        <xmacro_block name="geometry_box" x="0.055" y="0.367" z="0.055"/>
      </collision>
      <collision name="chassis_rear_wheel_holder_collision">
        <pose>-0.208 0 0 0 0 0</pose>
        <xmacro_block name="geometry_box" x="0.055" y="0.367" z="0.055"/>
      </collision>
      <sensor name="chassis_imu" type="imu">
        <always_on>1</always_on>
        <update_rate>200</update_rate>
      </sensor>
    </link>

    <!-- Same joint names, wheel radius, track and friction as upstream. -->
    <xmacro_block name="chassis_wheel_l" prefix="front_left" parent="chassis" pose="0.207 0.194 0 0 0 0"/>
    <xmacro_block name="chassis_wheel_r" prefix="front_right" parent="chassis" pose="0.207 -0.194 0 0 0 0"/>
    <xmacro_block name="chassis_wheel_r" prefix="rear_left" parent="chassis" pose="-0.207 0.194 0 0 0 0"/>
    <xmacro_block name="chassis_wheel_l" prefix="rear_right" parent="chassis" pose="-0.207 -0.194 0 0 0 0"/>
  </xmacro_define_block>

  <!-- Local 2D lidar: same link/sensor names, simplified box body + collision. -->
  <xmacro_define_block name="pb_low_rplidar_a2" params="prefix parent pose update_rate samples visualize">
    <joint name="${prefix}rplidar_a2_joint" type="fixed">
      <pose relative_to="${parent}">${pose}</pose>
      <parent>${parent}</parent>
      <child>${prefix}rplidar_a2</child>
    </joint>
    <link name="${prefix}rplidar_a2">
      <pose relative_to="${prefix}rplidar_a2_joint">0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0.02 0 0 0</pose>
        <xmacro_block name="inertia_box" m="0.15" x="0.08" y="0.08" z="0.04" />
      </inertial>
      <visual name="visual">
        <pose>0 0 0.02 0 0 0</pose>
        <xmacro_block name="geometry_box" x="0.08" y="0.08" z="0.04"/>
      </visual>
      <collision name="collision">
        <pose>0 0 0.02 0 0 0</pose>
        <xmacro_block name="geometry_box" x="0.08" y="0.08" z="0.04"/>
      </collision>
      <sensor name="${prefix}rplidar_a2" type="gpu_lidar">
        <ignition_frame_id>${prefix}rplidar_a2</ignition_frame_id>
        <pose>0 0 0.03 0 0 0</pose>
        <always_on>true</always_on>
        <visualize>${visualize}</visualize>
        <update_rate>${update_rate}</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>${samples}</samples>
              <resolution>1.0</resolution>
              <min_angle>0</min_angle>
              <max_angle>6.28000020980835</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.15</min>
            <max>12.0</max>
          </range>
        </ray>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </sensor>
    </link>
  </xmacro_define_block>

  <!-- Local 3D lidar: horizontal mount, simplified box body, collision added
       (the upstream livox macro has none, so the sensor could pass through a
       ceiling it should hit). -->
  <xmacro_define_block name="pb_low_livox" params="prefix parent pose update_rate samples">
    <joint name="${prefix}livox_joint" type="fixed">
      <pose relative_to="${parent}">${pose}</pose>
      <parent>${parent}</parent>
      <child>${prefix}mid360</child>
    </joint>
    <link name="${prefix}mid360">
      <pose relative_to="${prefix}livox_joint">0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0.02 0 0 0</pose>
        <xmacro_block name="inertia_box" m="0.15" x="0.08" y="0.08" z="0.04" />
      </inertial>
      <visual name="visual">
        <pose>0 0 0.02 0 0 0</pose>
        <xmacro_block name="geometry_box" x="0.08" y="0.08" z="0.04"/>
      </visual>
      <collision name="collision">
        <pose>0 0 0.02 0 0 0</pose>
        <xmacro_block name="geometry_box" x="0.08" y="0.08" z="0.04"/>
      </collision>

      <sensor name="${prefix}mid360_imu" type="imu">
        <ignition_frame_id>${prefix}mid360</ignition_frame_id>
        <always_on>1</always_on>
        <update_rate>200</update_rate>
        <visualize>true</visualize>
      </sensor>

      <sensor name="${prefix}mid360_lidar" type="gpu_lidar">
        <ignition_frame_id>${prefix}mid360</ignition_frame_id>
        <pose>0 0 0.03 0 0 0</pose>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>${update_rate}</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>${samples}</samples>
              <resolution>1.0</resolution>
              <min_angle>0</min_angle>
              <max_angle>6.2831852</max_angle>
            </horizontal>
            <vertical>
              <samples>32</samples>
              <min_angle>-0.12217304764</min_angle>
              <max_angle>0.90757121104</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>40.0</max>
          </range>
        </ray>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </sensor>
    </link>
  </xmacro_define_block>

  <!-- Local forward camera, fixed mount (the gimbal no longer exists).
       The link keeps the documented pose; the sensor itself sits at the front
       face of the housing so the chassis box cannot block the near clip. -->
  <xmacro_define_block name="pb_low_industrial_camera" params="prefix parent pose update_rate horizontal_fov width height">
    <joint name="${prefix}industrial_camera_joint" type="fixed">
      <pose relative_to="${parent}">${pose}</pose>
      <parent>${parent}</parent>
      <child>${prefix}industrial_camera</child>
    </joint>
    <link name="${prefix}industrial_camera">
      <pose relative_to="${prefix}industrial_camera_joint">0 0 0 0 0 0</pose>
      <inertial>
        <pose>0.025 0 0 0 0 0</pose>
        <xmacro_block name="inertia_box" m="0.050" x="0.08" y="0.025" z="0.033" />
      </inertial>
      <visual name="visual">
        <pose>0.025 0 0 0 0 0</pose>
        <xmacro_block name="geometry_box" x="0.08" y="0.025" z="0.033" />
      </visual>
      <collision name="collision">
        <pose>0.025 0 0 0 0 0</pose>
        <xmacro_block name="geometry_box" x="0.08" y="0.025" z="0.033" />
      </collision>
      <sensor name="${prefix}industrial_camera" type="camera">
        <pose>0.045 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>${update_rate}</update_rate>
        <camera>
          <optical_frame_id>${prefix}industrial_camera_optical_frame</optical_frame_id>
          <horizontal_fov>${horizontal_fov}</horizontal_fov>
          <image>
            <width>${width}</width>
            <height>${height}</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
      </sensor>
    </link>
    <joint name="${prefix}industrial_camera_optical_joint" type="fixed">
      <pose relative_to="${prefix}industrial_camera">0 0 0 ${-pi/2} 0 ${-pi/2}</pose>
      <parent>${prefix}industrial_camera</parent>
      <child>${prefix}industrial_camera_optical_frame</child>
    </joint>
    <link name="${prefix}industrial_camera_optical_frame">
      <pose relative_to="${prefix}industrial_camera_optical_joint">0 0 0 0 0 0</pose>
    </link>
  </xmacro_define_block>

  <model name="pb_navigation_robot">
    <!-- The create action supplies the sole world spawn pose. -->
    <xmacro_block name="pb_low_chassis" chassis_height="0.076" />

    <!-- Low, fixed sensor installation (first-pass candidate values). -->
    <xmacro_block name="pb_low_rplidar_a2" prefix="front_" parent="chassis"
      pose="-0.10 0 0.11 0 0 0" update_rate="10" samples="400" visualize="true" />
    <xmacro_block name="pb_low_livox" prefix="front_" parent="chassis"
      pose="0.10 0 0.11 0 0 0" update_rate="20" samples="360" />
    <xmacro_block name="pb_low_industrial_camera" prefix="front_" parent="chassis"
      pose="0.16 0 0.065 0 0 0" update_rate="30" horizontal_fov="1" width="1920" height="1080" />

    <plugin filename="ignition-gazebo-joint-state-publisher-system"
      name="ignition::gazebo::systems::JointStatePublisher">
      <topic>/robot/joint_states</topic>
    </plugin>

    <plugin filename="ignition-gazebo-pose-publisher-system"
      name="ignition::gazebo::systems::PosePublisher">
      <publish_link_pose>true</publish_link_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_model_pose>true</publish_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <static_publisher>false</static_publisher>
      <update_frequency>50</update_frequency>
    </plugin>

    <!-- The upstream LightBarController mutates scene visuals and crashes
         Ignition Fortress when the Sensors renderer owns the same visuals.
         The light-bar meshes are gone from the low chassis anyway. -->

    <plugin filename="MecanumDrive2" name="ignition::gazebo::systems::MecanumDrive2">
      <chassis_link>chassis</chassis_link>
      <front_left_joint>front_left_wheel_joint</front_left_joint>
      <front_right_joint>front_right_wheel_joint</front_right_joint>
      <rear_left_joint>rear_left_wheel_joint</rear_left_joint>
      <rear_right_joint>rear_right_wheel_joint</rear_right_joint>
    </plugin>

    <!-- Single same-step source of navigation truth (see
         doc/PB_SLOPE_REPAIR_AND_DEPLOYMENT_PLAN.md section 4).  The chassis pose
         and the engine velocities are read in one simulation step and stamped
         with that step's simulation time, so the navigation chain never has to
         fuse two asynchronous streams.  Poses are world-frame, the twist is
         expressed in the chassis frame per the odometry contract; the
         MecanumDrive2 odometry stays available for comparison but is not used as
         the production source because it publishes yaw-only orientation and no z.
         The plugin library comes from pb_gazebo_sim_support, whose environment
         hook puts it on the Gazebo system plugin path. -->
    <plugin filename="pb_chassis_truth_system"
            name="pb_gazebo_sim_support::ChassisTruth">
      <link_name>chassis</link_name>
      <topic>/pb_sim/chassis_truth</topic>
      <world_frame>rmuc2026_field</world_frame>
      <child_frame>chassis</child_frame>
      <publish_period_s>0.01</publish_period_s>
    </plugin>

    <!-- Read-only contact/actuator diagnostics (see
         doc/PB_SLOPE_NEXT_STEPS_20260921.md P1).  DEFAULT OFF: with <enable>false
         the plugin logs one line and then never advertises a topic, never creates a
         component and never publishes.  It only READS engine state — requested body
         wrench, joint velocity/position/force and contact sensor data — and never
         writes a component or touches mass, friction, collision geometry, gravity or
         any controller parameter, so switching it on cannot change the outcome of
         the run it is measuring.

         Turning it on is a deliberate edit of this one element:
           <enable>false</enable>  ->  <enable>true</enable>
         Actuator diagnostics need no other prerequisite.  Contact diagnostics
         additionally need a <sensor type="contact"> on the chassis and the world to
         load ignition-gazebo-contact-system; without them the plugin says so rather
         than publishing a silent empty stream, so set <enable_contact>false</enable_contact>
         when only the actuator half is wanted. -->
    <plugin filename="pb_contact_diagnostics_system"
            name="pb_gazebo_sim_support::ContactDiagnostics">
      <enable>false</enable>
      <enable_actuator>true</enable_actuator>
      <enable_contact>true</enable_contact>
      <link_name>chassis</link_name>
      <joints>front_left_wheel_joint front_right_wheel_joint rear_left_wheel_joint rear_right_wheel_joint</joints>
      <topic_prefix>/pb_sim/diagnostics</topic_prefix>
      <publish_period_s>0.05</publish_period_s>
    </plugin>

    <!-- No gimbal JointController plugins: the gimbal joints do not exist. -->
  </model>
</sdf>
