<?xml version="1.0"?>
<sdf version="1.7">
	
	
	
	
	
	<model name="pb_navigation_robot">
		
		<link name="base_footprint" />
		<joint name="base_to_chassis" type="fixed">
			<pose>0 0 0.076 0 0 0</pose>
			<parent>base_footprint</parent>
			<child>chassis</child>
		</joint>
		<link name="chassis">
			<inertial>
				
				<pose>0 0 0.055 0 0 0</pose>
				<mass>15.0</mass>
				<inertia>
					<ixx>0.093125</ixx>
					<ixy>0</ixy>
					<ixz>0</ixz>
					<iyy>0.18312499999999998</iyy>
					<iyz>0</iyz>
					<izz>0.23399999999999999</izz>
				</inertia>
			</inertial>
			
			<visual name="chassis_visual">
				<pose>0 0 0.045 0 0 0</pose>
				<geometry>
					<box>
						<size>0.36 0.24 0.13</size>
					</box>
				</geometry>
			</visual>
			<collision name="chassis_base_collision">
				<pose>0 0 0.045 0 0 0</pose>
				<geometry>
					<box>
						<size>0.36 0.24 0.13</size>
					</box>
				</geometry>
			</collision>
			<collision name="chassis_fornt_wheel_holder_collision">
				<pose>0.208 0 0 0 0 0</pose>
				<geometry>
					<box>
						<size>0.055 0.367 0.055</size>
					</box>
				</geometry>
			</collision>
			<collision name="chassis_rear_wheel_holder_collision">
				<pose>-0.208 0 0 0 0 0</pose>
				<geometry>
					<box>
						<size>0.055 0.367 0.055</size>
					</box>
				</geometry>
			</collision>
			<sensor name="chassis_imu" type="imu">
				<always_on>1</always_on>
				<update_rate>200</update_rate>
			<topic>/robot/imu</topic></sensor>
		</link>
		
		<joint name="front_left_wheel_joint" type="revolute">
			<pose relative_to="chassis">0.207 0.194 0 0 0 0</pose>
			<parent>chassis</parent>
			<child>front_left_wheel</child>
			<axis>
				<xyz>0 1 0</xyz>
				<limit>
					<lower>-1.79769e+308</lower>
					<upper>1.79769e+308</upper>
					<effort>1e+10</effort>
					<velocity>1e+10</velocity>
				</limit>
			</axis>
		</joint>
		<link name="front_left_wheel">
			<pose relative_to="front_left_wheel_joint">0 0 0 0 0 0</pose>
			<inertial>
				<pose>0 0 0 1.5707 0 0</pose>
				<mass>0.4</mass>
				<inertia>
					<ixx>0.0006426653333333334</ixx>
					<ixy>0</ixy>
					<ixz>0</ixz>
					<iyy>0.0006426653333333334</iyy>
					<iyz>0</iyz>
					<izz>0.0011491280000000001</izz>
				</inertia>
			</inertial>
			<visual name="front_left_wheel_visual">
				<geometry>
					<mesh>
						<uri>model://rmua19_standard_robot/meshes/wheel_left.dae</uri>
					</mesh>
				</geometry>
			</visual>
			<collision name="front_left_wheel_collision">
				<pose>0 0 0 1.5707 0 0</pose>
				<geometry>
					<cylinder>
						<radius>0.0758</radius>
						<length>0.0452</length>
					</cylinder>
				</geometry>
				<surface>
					<friction>
						<ode>
							<mu>0.2</mu>
							<mu2>0.2</mu2>
						</ode>
					</friction>
				</surface>
			</collision>
		</link>
		<joint name="front_right_wheel_joint" type="revolute">
			<pose relative_to="chassis">0.207 -0.194 0 0 0 0</pose>
			<parent>chassis</parent>
			<child>front_right_wheel</child>
			<axis>
				<xyz>0 1 0</xyz>
				<limit>
					<lower>-1.79769e+308</lower>
					<upper>1.79769e+308</upper>
					<effort>1e+10</effort>
					<velocity>1e+10</velocity>
				</limit>
			</axis>
		</joint>
		<link name="front_right_wheel">
			<pose relative_to="front_right_wheel_joint">0 0 0 0 0 0</pose>
			<inertial>
				<pose>0 0 0 1.5707 0 0</pose>
				<mass>0.4</mass>
				<inertia>
					<ixx>0.0006426653333333334</ixx>
					<ixy>0</ixy>
					<ixz>0</ixz>
					<iyy>0.0006426653333333334</iyy>
					<iyz>0</iyz>
					<izz>0.0011491280000000001</izz>
				</inertia>
			</inertial>
			<visual name="front_right_wheel_visual">
				<geometry>
					<mesh>
						<uri>model://rmua19_standard_robot/meshes/wheel_right.dae</uri>
					</mesh>
				</geometry>
			</visual>
			<collision name="front_right_wheel_collision">
				<pose>0 0 0 1.5707 0 0</pose>
				<geometry>
					<cylinder>
						<radius>0.0758</radius>
						<length>0.0452</length>
					</cylinder>
				</geometry>
				<surface>
					<friction>
						<ode>
							<mu>0.2</mu>
							<mu2>0.2</mu2>
						</ode>
					</friction>
				</surface>
			</collision>
		</link>
		<joint name="rear_left_wheel_joint" type="revolute">
			<pose relative_to="chassis">-0.207 0.194 0 0 0 0</pose>
			<parent>chassis</parent>
			<child>rear_left_wheel</child>
			<axis>
				<xyz>0 1 0</xyz>
				<limit>
					<lower>-1.79769e+308</lower>
					<upper>1.79769e+308</upper>
					<effort>1e+10</effort>
					<velocity>1e+10</velocity>
				</limit>
			</axis>
		</joint>
		<link name="rear_left_wheel">
			<pose relative_to="rear_left_wheel_joint">0 0 0 0 0 0</pose>
			<inertial>
				<pose>0 0 0 1.5707 0 0</pose>
				<mass>0.4</mass>
				<inertia>
					<ixx>0.0006426653333333334</ixx>
					<ixy>0</ixy>
					<ixz>0</ixz>
					<iyy>0.0006426653333333334</iyy>
					<iyz>0</iyz>
					<izz>0.0011491280000000001</izz>
				</inertia>
			</inertial>
			<visual name="rear_left_wheel_visual">
				<geometry>
					<mesh>
						<uri>model://rmua19_standard_robot/meshes/wheel_right.dae</uri>
					</mesh>
				</geometry>
			</visual>
			<collision name="rear_left_wheel_collision">
				<pose>0 0 0 1.5707 0 0</pose>
				<geometry>
					<cylinder>
						<radius>0.0758</radius>
						<length>0.0452</length>
					</cylinder>
				</geometry>
				<surface>
					<friction>
						<ode>
							<mu>0.2</mu>
							<mu2>0.2</mu2>
						</ode>
					</friction>
				</surface>
			</collision>
		</link>
		<joint name="rear_right_wheel_joint" type="revolute">
			<pose relative_to="chassis">-0.207 -0.194 0 0 0 0</pose>
			<parent>chassis</parent>
			<child>rear_right_wheel</child>
			<axis>
				<xyz>0 1 0</xyz>
				<limit>
					<lower>-1.79769e+308</lower>
					<upper>1.79769e+308</upper>
					<effort>1e+10</effort>
					<velocity>1e+10</velocity>
				</limit>
			</axis>
		</joint>
		<link name="rear_right_wheel">
			<pose relative_to="rear_right_wheel_joint">0 0 0 0 0 0</pose>
			<inertial>
				<pose>0 0 0 1.5707 0 0</pose>
				<mass>0.4</mass>
				<inertia>
					<ixx>0.0006426653333333334</ixx>
					<ixy>0</ixy>
					<ixz>0</ixz>
					<iyy>0.0006426653333333334</iyy>
					<iyz>0</iyz>
					<izz>0.0011491280000000001</izz>
				</inertia>
			</inertial>
			<visual name="rear_right_wheel_visual">
				<geometry>
					<mesh>
						<uri>model://rmua19_standard_robot/meshes/wheel_left.dae</uri>
					</mesh>
				</geometry>
			</visual>
			<collision name="rear_right_wheel_collision">
				<pose>0 0 0 1.5707 0 0</pose>
				<geometry>
					<cylinder>
						<radius>0.0758</radius>
						<length>0.0452</length>
					</cylinder>
				</geometry>
				<surface>
					<friction>
						<ode>
							<mu>0.2</mu>
							<mu2>0.2</mu2>
						</ode>
					</friction>
				</surface>
			</collision>
		</link>
		
		<joint name="front_rplidar_a2_joint" type="fixed">
			<pose relative_to="chassis">-0.10 0 0.11 0 0 0</pose>
			<parent>chassis</parent>
			<child>front_rplidar_a2</child>
		</joint>
		<link name="front_rplidar_a2">
			<pose relative_to="front_rplidar_a2_joint">0 0 0 0 0 0</pose>
			<inertial>
				<pose>0 0 0.02 0 0 0</pose>
				<mass>0.15</mass>
				<inertia>
					<ixx>9.999999999999999e-05</ixx>
					<ixy>0</ixy>
					<ixz>0</ixz>
					<iyy>9.999999999999999e-05</iyy>
					<iyz>0</iyz>
					<izz>0.00016</izz>
				</inertia>
			</inertial>
			<visual name="visual">
				<pose>0 0 0.02 0 0 0</pose>
				<geometry>
					<box>
						<size>0.08 0.08 0.04</size>
					</box>
				</geometry>
			</visual>
			<collision name="collision">
				<pose>0 0 0.02 0 0 0</pose>
				<geometry>
					<box>
						<size>0.08 0.08 0.04</size>
					</box>
				</geometry>
			</collision>
			<sensor name="front_rplidar_a2" type="gpu_lidar">
				<ignition_frame_id>front_rplidar_a2</ignition_frame_id>
				<pose>0 0 0.03 0 0 0</pose>
				<always_on>true</always_on>
				<visualize>true</visualize>
				<update_rate>10.0</update_rate>
				<ray>
					<scan>
						<horizontal>
							<samples>400.0</samples>
							<resolution>1.0</resolution>
							<min_angle>0</min_angle>
							<max_angle>6.28000020980835</max_angle>
						</horizontal>
					</scan>
					<range>
						<min>0.15</min>
						<max>12.0</max>
					</range>
				</ray>
				<noise>
					<type>gaussian</type>
					<mean>0.0</mean>
					<stddev>0.01</stddev>
				</noise>
			<topic>/robot/scan</topic></sensor>
		</link>
		<joint name="front_livox_joint" type="fixed">
			<pose relative_to="chassis">0.10 0 0.11 0 0 0</pose>
			<parent>chassis</parent>
			<child>front_mid360</child>
		</joint>
		<link name="front_mid360">
			<pose relative_to="front_livox_joint">0 0 0 0 0 0</pose>
			<inertial>
				<pose>0 0 0.02 0 0 0</pose>
				<mass>0.15</mass>
				<inertia>
					<ixx>9.999999999999999e-05</ixx>
					<ixy>0</ixy>
					<ixz>0</ixz>
					<iyy>9.999999999999999e-05</iyy>
					<iyz>0</iyz>
					<izz>0.00016</izz>
				</inertia>
			</inertial>
			<visual name="visual">
				<pose>0 0 0.02 0 0 0</pose>
				<geometry>
					<box>
						<size>0.08 0.08 0.04</size>
					</box>
				</geometry>
			</visual>
			<collision name="collision">
				<pose>0 0 0.02 0 0 0</pose>
				<geometry>
					<box>
						<size>0.08 0.08 0.04</size>
					</box>
				</geometry>
			</collision>
			<sensor name="front_mid360_imu" type="imu">
				<ignition_frame_id>front_mid360</ignition_frame_id>
				<always_on>1</always_on>
				<update_rate>200</update_rate>
				<visualize>true</visualize>
			</sensor>
			<sensor name="front_mid360_lidar" type="gpu_lidar">
				<ignition_frame_id>front_mid360</ignition_frame_id>
				<pose>0 0 0.03 0 0 0</pose>
				<always_on>true</always_on>
				<visualize>true</visualize>
				<update_rate>20.0</update_rate>
				<ray>
					<scan>
						<horizontal>
							<samples>720.0</samples>
							<resolution>1.0</resolution>
							<min_angle>0</min_angle>
							<max_angle>6.2831852</max_angle>
						</horizontal>
						<vertical>
							<samples>16</samples>
							<min_angle>-0.12217304764</min_angle>
							<max_angle>0.90757121104</max_angle>
						</vertical>
					</scan>
					<range>
						<min>0.1</min>
						<max>40.0</max>
					</range>
				</ray>
				<noise>
					<type>gaussian</type>
					<mean>0.0</mean>
					<stddev>0.01</stddev>
				</noise>
			<topic>/robot/cloud/points</topic></sensor>
		</link>
		<joint name="front_industrial_camera_joint" type="fixed">
			<pose relative_to="chassis">0.16 0 0.065 0 0 0</pose>
			<parent>chassis</parent>
			<child>front_industrial_camera</child>
		</joint>
		<link name="front_industrial_camera">
			<pose relative_to="front_industrial_camera_joint">0 0 0 0 0 0</pose>
			<inertial>
				<pose>0.025 0 0 0 0 0</pose>
				<mass>0.05</mass>
				<inertia>
					<ixx>7.141666666666669e-06</ixx>
					<ixy>0</ixy>
					<ixz>0</ixz>
					<iyy>3.1204166666666675e-05</iyy>
					<iyz>0</iyz>
					<izz>2.9270833333333334e-05</izz>
				</inertia>
			</inertial>
			<visual name="visual">
				<pose>0.025 0 0 0 0 0</pose>
				<geometry>
					<box>
						<size>0.08 0.025 0.033</size>
					</box>
				</geometry>
			</visual>
			<collision name="collision">
				<pose>0.025 0 0 0 0 0</pose>
				<geometry>
					<box>
						<size>0.08 0.025 0.033</size>
					</box>
				</geometry>
			</collision>
			<sensor name="front_industrial_camera" type="camera">
				<pose>0.045 0 0 0 0 0</pose>
				<always_on>1</always_on>
				<update_rate>30.0</update_rate>
				<camera>
					<optical_frame_id>front_industrial_camera_optical_frame</optical_frame_id>
					<horizontal_fov>1.0</horizontal_fov>
					<image>
						<width>1920.0</width>
						<height>1080.0</height>
					</image>
					<clip>
						<near>0.1</near>
						<far>100</far>
					</clip>
				</camera>
			<topic>/robot/camera/image</topic></sensor>
		</link>
		<joint name="front_industrial_camera_optical_joint" type="fixed">
			<pose relative_to="front_industrial_camera">0 0 0 -1.5707963267948966 0 -1.5707963267948966</pose>
			<parent>front_industrial_camera</parent>
			<child>front_industrial_camera_optical_frame</child>
		</joint>
		<link name="front_industrial_camera_optical_frame">
			<pose relative_to="front_industrial_camera_optical_joint">0 0 0 0 0 0</pose>
		</link>
		<plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher">
			<topic>/robot/joint_states</topic>
		</plugin>
		<plugin filename="ignition-gazebo-pose-publisher-system" name="ignition::gazebo::systems::PosePublisher">
			<publish_link_pose>true</publish_link_pose>
			<publish_sensor_pose>false</publish_sensor_pose>
			<publish_visual_pose>false</publish_visual_pose>
			<publish_collision_pose>false</publish_collision_pose>
			<publish_model_pose>true</publish_model_pose>
			<use_pose_vector_msg>true</use_pose_vector_msg>
			<static_publisher>false</static_publisher>
			<update_frequency>50</update_frequency>
		</plugin>
		
		<plugin filename="MecanumDrive2" name="ignition::gazebo::systems::MecanumDrive2">
			<chassis_link>chassis</chassis_link>
			<front_left_joint>front_left_wheel_joint</front_left_joint>
			<front_right_joint>front_right_wheel_joint</front_right_joint>
			<rear_left_joint>rear_left_wheel_joint</rear_left_joint>
			<rear_right_joint>rear_right_wheel_joint</rear_right_joint>
		</plugin>
		
		<plugin filename="pb_chassis_truth_system" name="pb_gazebo_sim_support::ChassisTruth">
			<link_name>chassis</link_name>
			<topic>/pb_sim/chassis_truth</topic>
			<world_frame>rmuc2026_field</world_frame>
			<child_frame>chassis</child_frame>
			<publish_period_s>0.01</publish_period_s>
		</plugin>
		
		<plugin filename="pb_contact_diagnostics_system" name="pb_gazebo_sim_support::ContactDiagnostics">
			<enable>false</enable>
			<enable_actuator>true</enable_actuator>
			<enable_contact>true</enable_contact>
			<link_name>chassis</link_name>
			<joints>front_left_wheel_joint front_right_wheel_joint rear_left_wheel_joint rear_right_wheel_joint</joints>
			<topic_prefix>/pb_sim/diagnostics</topic_prefix>
			<publish_period_s>0.05</publish_period_s>
		</plugin>
		
	</model>
</sdf>
