Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/PointCloud2
      Name: Source PCD (scene only)
      Enabled: true
      Alpha: 0.45
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Topic:
        Value: /meshnav/source_cloud
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Value: true
    - Class: rviz_mesh_tools_plugins/Mesh
      Name: MeshNav surface (planning)
      Enabled: true
      Geometry Topic:
        Value: /move_base_flex/mesh
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Display Type:
        Value: Vertex Costs
        Color Scale: Rainbow
        Costs Topic:
          Value: /move_base_flex/vertex_costs
          Depth: 20
          Durability Policy: Volatile
          Reliability Policy: Reliable
          History Policy: Keep Last
        Vertex Colors Topic:
          Value: /move_base_flex/vertex_colors
          Depth: 10
          Durability Policy: Transient Local
          Reliability Policy: Reliable
          History Policy: Keep Last
        Vertex Costs Type: final
        Faces Alpha: 0.3
        Faces Color: 255; 255; 255
      Show Wireframe:
        Value: true
        Wireframe Color: 0; 0; 0
        Wireframe Alpha: 0.35
      Value: true
    - Class: rviz_default_plugins/Path
      Name: GetPath result
      Enabled: true
      Color: 255; 255; 255
      Line Style: Lines
      Line Width: 0.15
      Topic:
        Value: /move_base_flex/path
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
      Value: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 30
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.7
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1400
