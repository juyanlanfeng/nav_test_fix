<?xml version="1.0"?>
<package format="3">
  <name>meshnav_runtime</name>
  <version>0.1.0</version>
  <description>MeshNav coordinator and explicit-enable real-robot command gateway.</description>
  <maintainer email="maintainers@example.invalid">nav_test maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>action_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>mbf_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
