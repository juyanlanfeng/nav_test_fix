+    bool fresh(const sensor_msgs::msg::PointCloud2& msg) {
+        if (msg.header.stamp.sec < 0 ||
+            (msg.header.stamp.sec == 0 && msg.header.stamp.nanosec == 0) ||
+            msg.header.stamp.nanosec >= 1000000000u) return false;
+        const auto stamp = rclcpp::Time(msg.header.stamp, get_clock()->get_clock_type());
+        const double age = (now() - stamp).seconds();
+        return age >= -max_future_s_ && age <= max_cloud_age_s_;
+    }
+
+    bool validTransform(const geometry_msgs::msg::Transform& transform) {
+        const auto& t = transform.translation;
+        const auto& q = transform.rotation;
+        const double norm2 = q.x*q.x + q.y*q.y + q.z*q.z + q.w*q.w;
+        return std::isfinite(t.x) && std::isfinite(t.y) && std::isfinite(t.z) &&
+            std::isfinite(norm2) && std::abs(norm2 - 1.0) <= 0.01;
+    }
+
+    bool validLayout(const sensor_msgs::msg::PointCloud2& msg) {
+        if (msg.is_bigendian || msg.height == 0 || msg.point_step == 0 ||
+            uint64_t(msg.row_step) < uint64_t(msg.width) * msg.point_step ||
+            uint64_t(msg.data.size()) < uint64_t(msg.height) * msg.row_step) return false;
+        for (const auto* name : {"x", "y", "z"}) {
+            size_t found = 0;
+            for (const auto& field : msg.fields) {
+                if (field.name != name) continue;
+                if (field.datatype != sensor_msgs::msg::PointField::FLOAT32 ||
+                    field.count != 1 || uint64_t(field.offset) + 4 > msg.point_step)
+                    return false;
+                ++found;
+            }
+            if (found != 1) return false;
+        }
+        return true;
+    }
 
