-    const RampCorridor& c = corridors_[i];
-    double s_i = 0.0, lat = 0.0, tan_yaw = 0.0;
-    mesh_map::Vector closest, tan;
-    c.project(raw_pos, s_i, closest, lat, tan, tan_yaw);
