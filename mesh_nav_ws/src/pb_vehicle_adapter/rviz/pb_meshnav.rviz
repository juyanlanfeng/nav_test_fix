Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /RobotModel1
        - /Mesh Map1
      Splitter Ratio: 0.5
    Tree Height: 600
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /Mesh Goal1
    Name: Tool Properties
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: PBCloud
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.45
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: map
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /meshnav/robot_description
      Enabled: true
      Links:
        All Links Enabled: true
      Name: RobotModel
      TF Prefix: ""
      Update Interval: 0
      Visual Enabled: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: AxisColor
      Enabled: true
      Name: PBCloud
      Position Transformer: XYZ
      Size (Pixels): 3
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /cloud
      Use Fixed Frame: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.25
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
    - Class: rviz_mesh_tools_plugins/Mesh
      Culling Mode (HW): None
      Display Type:
        Color Scale: Rainbow
        Costs Topic:
          Depth: 20
          Durability Policy: Volatile
          History Policy: Keep Last
          Reliability Policy: Reliable
          Value: /move_base_flex/vertex_costs
        Faces Alpha: 0.30000001192092896
        Faces Color: 255; 255; 255
        Material Service Name: get_materials
        Show textured faces only: false
        Texture Service Name: get_texture
        Update Topic:
          Depth: 10
          Durability Policy: Volatile
          History Policy: Keep Last
          Reliability Policy: Reliable
          Value: /move_base_flex/vertex_costs/updates
        Use Custom limits:
          Value: false
          Vertex Costs Lower Limit: 0
          Vertex Costs Upper Limit: 1
        Value: Vertex Costs
        Vertex Color Service Name: get_vertex_colors
        Vertex Colors Topic:
          Depth: 10
          Durability Policy: Transient Local
          History Policy: Keep Last
          Reliability Policy: Reliable
          Value: /move_base_flex/vertex_colors
        Vertex Costs Type: final
        Visualization Update Rate: 10
      Enabled: true
      Geometry Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /move_base_flex/mesh
      Name: Mesh Map
      Show Normals:
        Normals Alpha: 1
        Normals Color: 255; 0; 255
        Normals Scaling Factor: 1
        Value: false
      Show Wireframe:
        Value: true
        Wireframe Alpha: 1
        Wireframe Color: 0; 0; 0
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 25; 255; 0
      Enabled: true
      Line Style: Lines
      Line Width: 0.029999999329447746
      Name: MeshNavPath
      Pose Color: 255; 85; 255
      Pose Style: None
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /move_base_flex/path
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
    - Class: rviz_mesh_tools_plugins/MeshGoal
      Intersection Layer: 0
      Switch Bottom/Top: false
      Topic: /rviz/goal_pose
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10
      Focal Point:
        X: -1.9
        Y: 5.95
        Z: 0
      Pitch: 0.785
      Target Frame: base_footprint
      Yaw: 0.785
Window Geometry:
  Height: 900
  Width: 1500
